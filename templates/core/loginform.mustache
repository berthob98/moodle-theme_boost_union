{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                // Focus on the username field on error.
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                // Append a non-breaking space to the error/status message so screen readers will announce them after page load.
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    {{#togglepassword}}
        require(['core/togglesensitive'], function(ToggleSensitive) {
            ToggleSensitive.init("password", {{smallscreensonly}});
        });
    {{/togglepassword}}
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
    {{#loginaccordion}}
    require(['jquery'], function($) {
        // Wait for Bootstrap to be available, then initialize accordion.
        function whenBootstrapIsAvailable(callback) {
            if (typeof $().collapse === 'function') {
                callback();
            } else {
                setTimeout(function() {
                    whenBootstrapIsAvailable(callback);
                }, 100);
            }
        }
        
        $(document).ready(function() {
            whenBootstrapIsAvailable(function() {
                // Bootstrap 5 collapse should work automatically with data-bs-toggle="collapse",
                // but we ensure proper initialization and accordion behavior.
                $('#theme_boost_union-loginorder .card-header .btn-link').on('click', function() {
                    var $button = $(this);
                    // Use attr() to read data-bs-target attribute (Bootstrap 5)
                    var targetSelector = $button.attr('data-bs-target');
                    var $target = $(targetSelector);
                    // Use attr() to read data-bs-parent attribute (Bootstrap 5)
                    var parentSelector = $target.attr('data-bs-parent');
                    var $parent = $(parentSelector);
                    
                    // If this is an accordion (has parent), close other open items.
                    if ($parent.length > 0) {
                        $parent.find('.collapse.show').not($target).collapse('hide');
                    }
                });
            });
        });
    });
    {{/loginaccordion}}
    {{#logintabs}}
    require(['jquery'], function($) {
        // Wait for Bootstrap to be available, then initialize tabs.
        function whenBootstrapIsAvailable(callback) {
            if (typeof $().tab === 'function') {
                callback();
            } else {
                setTimeout(function() {
                    whenBootstrapIsAvailable(callback);
                }, 100);
            }
        }
        
        $(document).ready(function() {
            whenBootstrapIsAvailable(function() {
                var $tabs = $('#login-tabs a[data-bs-toggle="tab"]');
                var $tabPanes = $('#login-tabs-content .tab-pane');
                
                // Check if tabs and panes exist.
                if ($tabs.length === 0 || $tabPanes.length === 0) {
                    return;
                }
                
                // Ensure only the first tab pane is visible initially.
                $tabPanes.removeClass('show active');
                var $firstActiveTab = $tabs.filter('.active').first();
                if ($firstActiveTab.length > 0) {
                    var firstTargetId = $firstActiveTab.attr('href');
                    $(firstTargetId).addClass('show active');
                } else {
                    // If no active tab link, activate the first one.
                    var $firstTab = $tabs.first();
                    if ($firstTab.length > 0) {
                        $firstTab.addClass('active').attr('aria-selected', 'true');
                        var firstTargetId = $firstTab.attr('href');
                        $(firstTargetId).addClass('show active');
                    }
                }
                
                // Handle tab clicks using Bootstrap's tab method.
                $tabs.on('click', function (e) {
                    e.preventDefault();
                    $(this).tab('show');
                });
            });
        });
    });
    {{/logintabs}}
{{/js}}
